{
  "manifest_version": 3,
  "name": "Bing Wallpaper HD",
  "version": "1.3.0",
  "description": "每天自动下载 Bing 每日一图 UHD，用作新标签页壁纸，并展示最常访问站点。",
  "minimum_chrome_version": "103",
  "permissions": [
    "alarms",
    "favicon",
    "storage",
    "topSites"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
